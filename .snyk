# Snyk (https://snyk.io) policy file
# Ignores the two unfixable Debian 13 base-image findings from python:3.12-slim.
# No patched .deb exists yet for either CVE; both are local link-following issues
# with minimal impact in a single-user container. Re-evaluate at expiry.
version: v1.25.0
ignore:
  SNYK-DEBIAN13-ATTR-17678182:
    - '*':
        reason: >
          Link Following in attr/libattr1 (introduced via python:3.12-slim base
          image). No fixed Debian package available yet. Low practical risk in a
          containerized, single-user server context. Tracking until Debian ships
          a patched version.
        expires: 2026-11-03T00:00:00.000Z
        created: 2026-08-05T00:00:00.000Z
  SNYK-DEBIAN13-ACL-17677866:
    - '*':
        reason: >
          Link Following in acl/libacl1 (introduced via python:3.12-slim base
          image). No fixed Debian package available yet. Low practical risk in a
          containerized, single-user server context. Tracking until Debian ships
          a patched version.
        expires: 2026-11-03T00:00:00.000Z
        created: 2026-08-05T00:00:00.000Z
patch: {}