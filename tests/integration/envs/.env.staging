# Where the post-deploy suite points for the staging environment. Committed
# rather than held as GitHub Environment variables so a hostname change is a
# reviewable diff, matching mindshub_inference/tests/integration/envs.
#
# cowork-server is reached over its public host, because the ingress is what
# authenticates the Bearer key. auth is reached over cluster DNS so the suite
# keeps working before and after Cloudflare Access protects /v1/internal* on
# the public host.
COWORK_BASE_URL=https://cowork.staging.mindshub.ai
COWORK_AUTH_INTERNAL_BASE_URL=http://auth.staging.svc.cluster.local:80
